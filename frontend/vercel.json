{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://ud5njouxc9.execute-api.us-east-1.amazonaws.com/prod/:path*"
    },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
